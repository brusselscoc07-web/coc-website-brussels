# Copy this file to .env.local and fill in what you have.
# Everything below except SESSION_SECRET is OPTIONAL in local development —
# leave it unset and the app falls back to a local, zero-account equivalent
# (see lib/db, lib/storage.ts, lib/email.ts). Required once deployed to production.

# --- Always required, even in local dev ---
# Signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Database (falls back to a local PGlite file in .data/pglite when unset) ---
DATABASE_URL=

# --- Email via Resend (falls back to console-logging the email when unset) ---
RESEND_API_KEY=
EMAIL_FROM="Church of Christ Brussels <onboarding@resend.dev>"
CONTACT_NOTIFY_EMAIL=

# --- File storage via Vercel Blob (falls back to a local uploads/ dir when unset) ---
BLOB_READ_WRITE_TOKEN=

# --- Only relevant for a real deployment ---
# Set automatically by Vercel — leave unset locally. On any other host, set
# APP_ENV=production yourself once real accounts are bound; this makes lib/env.ts
# fail loudly at boot if DATABASE_URL/RESEND_API_KEY/BLOB_READ_WRITE_TOKEN/
# CONTACT_NOTIFY_EMAIL are still missing, instead of silently running on local fallbacks.
APP_ENV=
